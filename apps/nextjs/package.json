    "@t3-oss/env-nextjs": "^0.6.0",
    "@tanstack/react-query": "^4.29.19",
    "@tanstack/react-table": "^8.9.3",
    "@trpc/client": "^10.45.4",
    "@trpc/next": "^10.45.4",
    "@trpc/react-query": "^10.45.4",
    "@trpc/server": "^10.45.4",
    "@vercel/analytics": "^1.0.1",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.258.0",
    "next": "^16.3.0",
