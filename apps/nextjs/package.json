    "@types/mdx": "^2.0.5",
    "@types/node": "^20.2.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.14",
    "concurrently": "^10.0.4",
